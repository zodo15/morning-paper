{
  "rewrites": [
    {
      "source": "/audio/:path*",
      "destination": "https://zodo15.github.io/morning-paper/audio/:path*"
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "data/cards-feed.json"
    }
  },
  "git": {
    "deploymentEnabled": {
      "cards-data": false
    }
  }
}
